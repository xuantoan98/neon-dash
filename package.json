{
  "name": "neon-dash",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Neon Dash — a dependency-free canvas endless runner",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node tools/check.mjs",
    "dev": "node tools/serve.mjs",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check && npm test",
    "assets": "node tools/assets.mjs",
    "precache": "node tools/precache.mjs",
    "release": "npm run verify && npm run precache && node tools/release.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
